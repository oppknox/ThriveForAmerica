{
  "$schema": "https://www.unpkg.com/wrangler@4.125.0/config-schema.json",
  "name": "thrive-for-america",
  "account_id": "a3e84f22cd2ca0c7eb8830c6e64ee29b",
  "main": "worker.js",
  "compatibility_date": "2026-08-23",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "thriveforamerica.com", "custom_domain": true },
    { "pattern": "www.thriveforamerica.com", "custom_domain": true },
    { "pattern": "thriveforamerica.org", "custom_domain": true },
    { "pattern": "www.thriveforamerica.org", "custom_domain": true }
  ]
}
